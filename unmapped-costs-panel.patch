+
+async function associateUnmappedCost(i){
+  const g = unmappedCostGroups[i]; if(!g) return;
+  const sel = document.getElementById(`unmap_unit_${i}`);
+  const unitId = sel && sel.value;
+  if(!unitId){ toast('Pick a unit first.'); return; }
+  const u = units.find(x=>x.id===unitId); if(!u) return;
+
+  if(u.serviceId && u.serviceId.trim().toLowerCase()!==g.serviceId.trim().toLowerCase()){
+    if(!confirm(`${u.name} already has Service ID "${u.serviceId}" on file. Replace it with "${g.serviceId}"?`)) return;
+  } else if(!confirm(`Associate Service ID "${g.serviceId}" (${g.rows.length} record(s), $${g.total.toFixed(2)}) with ${unitGroupKey(u)} — ${u.name}?`)){
+    return;
+  }
+
+  u.serviceId = g.serviceId;
+  if(!u.maintenanceHistory) u.maintenanceHistory = [];
+  g.rows.forEach(r=>{
+    const at = r.date ? new Date(r.date).toISOString() : new Date().toISOString();
+    u.maintenanceHistory.push({
+      openedBy: currentUser, openedAt: at,
+      reason: `Prior repair (imported): ${r.work || r.vendor || 'service call'}`,
+      entries: [],
+      outsideServiceCalls: [{
+        vendor: r.vendor || 'Outside service', cost: r.amount,
+        serviceDate: r.date, invoiceRef: r.invoice,
+        description: r.work, photo: null,
+        loggedBy: currentUser, at
+      }],
+      status:'closed', closedBy: currentUser, closedAt: at,
+      closeNotes:'Imported from cost CSV (matched from Unmapped Service IDs).'
+    });
+  });
+  await persistUnits();
+
+  pendingCostMatches = pendingCostMatches.filter(r=>!g.rows.includes(r));
+  await persistPendingCostMatches();
+
+  render(); renderCostsTab(); renderMaintenanceFrontPanel();
+  toast(`Associated ${g.rows.length} record(s) to ${u.name}.`);
+}
+
+async function dismissUnmappedCost(i){
+  const g = unmappedCostGroups[i]; if(!g) return;
+  if(!confirm(`Dismiss Service ID "${g.serviceId}" (${g.rows.length} record(s))? This removes it from the unmapped list without adding it to any unit — use this if it's not equipment this tracker covers.`)) return;
